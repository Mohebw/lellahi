generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  MANAGER
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String? // emoji or icon key
  image     String? // uploaded image path
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ProductBadge {
  NONE
  NEW
  FEATURED
  DISCOUNT
  OUT_OF_STOCK
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  brand           String
  model           String
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  price           Int // Toman, stored as integer
  compareAtPrice  Int? // for showing discount strike-through
  stock           Int               @default(0)
  isActive        Boolean           @default(true)
  shortDescription String?
  description     String?
  specs           Json? // { "RAM": "8GB", "Storage": "256GB", ... }
  colors          String[]          @default([])
  badge           ProductBadge      @default(NONE)
  images          ProductImage[]
  purchaseRequests PurchaseRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

enum PurchaseRequestStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
  CANCELLED
}

model PurchaseRequest {
  id            String                 @id @default(cuid())
  productId     String
  product       Product                @relation(fields: [productId], references: [id])
  customerName  String
  customerPhone String
  message       String?
  status        PurchaseRequestStatus  @default(NEW)
  telegramSent  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
}
