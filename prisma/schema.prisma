generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  MANAGER
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String? // emoji or icon key
  image     String? // uploaded image path
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum ProductBadge {
  NONE
  NEW
  FEATURED
  DISCOUNT
  OUT_OF_STOCK
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  brand           String
  model           String
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  price           Int // Toman, stored as integer
  compareAtPrice  Int? // for showing discount strike-through
  stock           Int               @default(0)
  isActive        Boolean           @default(true)
  shortDescription String?
  description     String?
  specs           Json? // { "RAM": "8GB", "Storage": "256GB", ... }
  colors          String[]          @default([])
  badge           ProductBadge      @default(NONE)
  videoUrl        String?
  images          ProductImage[]
  purchaseRequests PurchaseRequest[]
  reviews         Review[]
  stockAlerts     StockAlert[]
  orderItems      OrderItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([categoryId])
  @@index([brand])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  trackingCode  String      @unique
  customerName  String
  customerPhone String
  message       String?
  status        OrderStatus @default(NEW)
  telegramSent  Boolean     @default(false)
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantity      Int     @default(1)
  priceAtOrder  Int // snapshot of unit price at the moment of ordering

  @@index([orderId])
}

enum PurchaseRequestStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
  CANCELLED
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName String
  customerPhone String?
  rating       Int
  comment      String
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model StockAlert {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerPhone String
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([productId])
}

enum ChatChannel {
  WEB
  TELEGRAM
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatConversation {
  id         String        @id @default(cuid())
  channel    ChatChannel
  externalId String?       // web session id, or Telegram chat id
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@index([channel, externalId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

model UsedPhoneModel {
  id         String   @id @default(cuid())
  brand      String
  name       String
  basePrice  Int
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum UsedPhoneFactorCategory {
  HARDWARE
  SOFTWARE
  ACCESSORY
}

model UsedPhoneFactorOption {
  id          String                   @id @default(cuid())
  groupKey    String
  optionKey   String
  groupLabel  String
  optionLabel String
  category    UsedPhoneFactorCategory
  percent     Float
  isDefault   Boolean                  @default(false)
  order       Int                      @default(0)

  @@unique([groupKey, optionKey])
  @@index([groupKey])
}

model UsedPhoneBatterySetting {
  id                    String @id @default(cuid())
  thresholdPercent      Int    @default(80)
  percentPerPointBelow  Float  @default(0.5)
}

model PurchaseRequest {
  id            String                 @id @default(cuid())
  trackingCode  String                 @unique
  productId     String
  product       Product                @relation(fields: [productId], references: [id])
  customerName  String
  customerPhone String
  message       String?
  status        PurchaseRequestStatus  @default(NEW)
  telegramSent  Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
}
