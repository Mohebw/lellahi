# ============================================
# Lellahi Tel — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
# ============================================

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://lellahi_user:CHANGE_ME@localhost:5432/lellahi_tel?schema=public"

# --- Auth ---
# Generate a strong random secret: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_to_a_long_random_string"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://departman.ir"

# --- Telegram Bot (purchase-request notifications) ---
# Create a bot via @BotFather, get the token, then message the bot from each
# admin account and use @userinfobot (or the bot's own /start log) to find chat IDs.
TELEGRAM_BOT_TOKEN=""
# Comma-separated list — supports multiple admins, e.g. "111111111,222222222"
TELEGRAM_ADMIN_CHAT_IDS=""

# --- Initial admin account (used only by `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@departman.ir"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ============================================
# Future-scope variables (pre-scaffolded, not required today)
# ============================================

# --- Payment gateway (Zarinpal / IDPay / etc.) ---
# PAYMENT_GATEWAY_MERCHANT_ID=""
# PAYMENT_GATEWAY_CALLBACK_URL="https://departman.ir/api/payment/callback"

# --- SMS provider (e.g. Kavenegar, Ippanel) ---
# SMS_API_KEY=""
# SMS_SENDER_NUMBER=""

# --- WhatsApp Business API ---
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# --- Ticketing system ---
# TICKETING_ENABLED="false"

# --- Multi-admin roles / analytics ---
# ANALYTICS_WRITE_KEY=""
